#!/usr/bin/env bash
set -euo pipefail

# Resolve the executable path for resize hooks, including manual symlinks.
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
# shellcheck source=lib/layout.sh
source "$SCRIPT_DIR/lib/layout.sh"
# shellcheck source=lib/tools.sh
source "$SCRIPT_DIR/lib/tools.sh"

VERSION="0.2.0"

usage() {
  cat <<'USAGE'
Usage: iae [options] [project-path]

Opens (or reattaches to) a 4-pane tmux workspace for agentic development:
editor, coding agent, shell and git/logs.

Options:
  -h, --help       show this help
  -V, --version    show version

Environment:
  IAE_AGENT    command to run in the agent pane (default: the Omarchy
               default agent, else the first of claude, codex, opencode,
               gemini, aider found on PATH)
  IAE_EDITOR   editor to run in the editor pane (default: Omarchy's default
               editor, else $VISUAL/$EDITOR, else nvim/vim/nano)
  IAE_GIT      git TUI for the git pane (default: tig, else lazygit)

Requires tmux. Works on any Linux/macOS with tmux; Omarchy defaults are
used automatically when present.
USAGE
}

# Internal entry point: the window-resized hook (see layout_install_resize_hook)
# calls back into this same script to reflow an already-running session.
if [ "${1:-}" = "--reflow" ]; then
  SESSION="${2:-}"
  [ -n "$SESSION" ] || exit 0
  tmux has-session -t "$SESSION" 2>/dev/null || exit 0

  read -r COLS LINES < <(tmux display-message -p -t "$SESSION" '#{window_width} #{window_height}')
  NEW_STATE="$(detect_layout "$COLS" "$LINES")"
  CUR_STATE="$(tmux show-options -qv -t "$SESSION" @iae-layout)"
  [ "$NEW_STATE" = "$CUR_STATE" ] && exit 0

  layout_reflow "$SESSION" "$NEW_STATE"
  exit 0
fi

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  -V | --version) echo "iae $VERSION"; exit 0 ;;
  -*) echo "iae: unknown option '$1' (try --help)" >&2; exit 2 ;;
esac

if ! command -v tmux >/dev/null 2>&1; then
  echo "iae: dependency 'tmux' not found on PATH" >&2
  exit 1
fi

GIT_TOOL="$(resolve_git_tool)" || {
  echo "iae: dependency 'tig' or 'lazygit' not found on PATH" >&2
  exit 1
}

PROJECT_DIR="${1:-$PWD}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd -P)"
SESSION="iae-$(basename "$PROJECT_DIR" | tr '.: ' '_')-$(printf '%s' "$PROJECT_DIR" | cksum | cut -d' ' -f1)"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$SESSION"
  else
    tmux attach-session -t "$SESSION"
  fi
  exit 0
fi

EDITOR_CMD="$(resolve_editor)" || {
  echo "iae: no editor found (install nvim/vim/nano or set IAE_EDITOR)" >&2
  exit 1
}

AGENT_CMD="$(resolve_agent)" || {
  if on_omarchy; then
    echo "iae: no coding agent available; choose one with: omarchy default agent <name>" >&2
  else
    echo "iae: no coding agent found (install claude, codex, opencode, gemini or aider, or set IAE_AGENT)" >&2
  fi
  exit 1
}

# A detached session starts at tmux's default 80x24 until a client attaches,
# so building the layout immediately would compute it against that size.
# The later attach then resizes the whole session to the real terminal,
# which would trigger our own resize hook right away. Sizing upfront avoids
# both problems: distorted initial ratios and a redundant reflow.
read -r TERM_LINES TERM_COLS < <(stty size 2>/dev/null) || true
TERM_COLS="${TERM_COLS:-80}"
TERM_LINES="${TERM_LINES:-24}"

INITIAL_STATE="$(detect_layout "$TERM_COLS" "$TERM_LINES")"
layout_build_initial "$SESSION" "$INITIAL_STATE" "$PROJECT_DIR" "$EDITOR_CMD" "$GIT_TOOL" "$TERM_COLS" "$TERM_LINES" "$AGENT_CMD"
layout_install_resize_hook "$SESSION" "$SCRIPT_PATH"

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$SESSION"
else
  tmux attach-session -t "$SESSION"
fi
