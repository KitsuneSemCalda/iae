#!/usr/bin/env bash
set -euo pipefail

for dep in tmux nvim claude lazygit; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "iae: dependência '$dep' não encontrada no PATH" >&2
    exit 1
  fi
done

PROJECT_DIR="${1:-$PWD}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
SESSION="iae-$(basename "$PROJECT_DIR" | tr '.: ' '_')"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$SESSION"
  else
    tmux attach-session -t "$SESSION"
  fi
  exit 0
fi

EDITOR_PANE=$(tmux new-session -d -s "$SESSION" -c "$PROJECT_DIR" -n main -P -F '#{pane_id}')

AGENT_PANE=$(tmux split-window -t "$EDITOR_PANE" -h -l 20% -c "$PROJECT_DIR" -P -F '#{pane_id}')
tmux select-pane -t "$EDITOR_PANE"
SHELL_PANE=$(tmux split-window -t "$EDITOR_PANE" -v -l 30% -c "$PROJECT_DIR" -P -F '#{pane_id}')
GITLOG_PANE=$(tmux split-window -t "$SHELL_PANE" -h -l 66% -c "$PROJECT_DIR" -P -F '#{pane_id}')

tmux send-keys -t "$EDITOR_PANE" "nvim ." C-m
tmux send-keys -t "$AGENT_PANE" "claude" C-m
tmux send-keys -t "$GITLOG_PANE" "lazygit" C-m

tmux select-pane -t "$EDITOR_PANE"

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$SESSION"
else
  tmux attach-session -t "$SESSION"
fi
