#!/usr/bin/env bash
set -euo pipefail

# Resolve the real path, not the symlink's, so it works whether we're run
# straight from the clone or via the ~/.local/bin symlink install.sh makes.
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
# shellcheck source=lib/layout.sh
source "$SCRIPT_DIR/lib/layout.sh"

# Internal entry point: the window-resized hook (see layout_install_resize_hook)
# calls back into this same script to reflow an already-running session.
if [ "${1:-}" = "--reflow" ]; then
  SESSION="${2:-}"
  [ -n "$SESSION" ] || exit 0
  tmux has-session -t "$SESSION" 2>/dev/null || exit 0

  read -r COLS LINES < <(tmux display-message -p -t "$SESSION" '#{window_width} #{window_height}')
  NEW_STATE="$(detect_layout "$COLS" "$LINES")"
  CUR_STATE="$(tmux show-options -qv -t "$SESSION" @iae-layout)"
  [ "$NEW_STATE" = "$CUR_STATE" ] && exit 0

  layout_reflow "$SESSION" "$NEW_STATE"
  exit 0
fi

for dep in tmux omarchy-agent; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "iae: dependency '$dep' not found on PATH" >&2
    exit 1
  fi
done

GIT_TOOL=""
for candidate in tig lazygit; do
  if command -v "$candidate" >/dev/null 2>&1; then
    GIT_TOOL="$candidate"
    break
  fi
done
if [ -z "$GIT_TOOL" ]; then
  echo "iae: dependency 'tig' or 'lazygit' not found on PATH" >&2
  exit 1
fi

PROJECT_DIR="${1:-$PWD}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd -P)"
SESSION="iae-$(basename "$PROJECT_DIR" | tr '.: ' '_')-$(printf '%s' "$PROJECT_DIR" | cksum | cut -d' ' -f1)"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$SESSION"
  else
    tmux attach-session -t "$SESSION"
  fi
  exit 0
fi

# Mirrors omarchy-launch-editor's own TUI allowlist: only these are safe to
# exec inline in a tmux pane. A GUI default (code, cursor, emacs, ...) would
# detach and leave the pane idle, so fall back to nvim instead.
EDITOR_CMD="$(omarchy-default-editor 2>/dev/null || echo nvim)"
case "$EDITOR_CMD" in
  nvim | vim | nano | micro | hx | helix | fresh) ;;
  *) EDITOR_CMD="nvim" ;;
esac
if ! command -v "$EDITOR_CMD" >/dev/null 2>&1; then
  if [ "$EDITOR_CMD" = "nvim" ] || ! command -v nvim >/dev/null 2>&1; then
    echo "iae: editor '$EDITOR_CMD' not found on PATH (and no 'nvim' fallback available)" >&2
    exit 1
  fi
  EDITOR_CMD="nvim"
fi

# A detached session starts at tmux's default 80x24 until a client attaches,
# so building the layout immediately would compute it against that size.
# The later attach then resizes the whole session to the real terminal,
# which would trigger our own resize hook right away. Sizing upfront avoids
# both problems: distorted initial ratios and a redundant reflow.
read -r TERM_LINES TERM_COLS < <(stty size 2>/dev/null) || true
TERM_COLS="${TERM_COLS:-80}"
TERM_LINES="${TERM_LINES:-24}"

INITIAL_STATE="$(detect_layout "$TERM_COLS" "$TERM_LINES")"
layout_build_initial "$SESSION" "$INITIAL_STATE" "$PROJECT_DIR" "$EDITOR_CMD" "$GIT_TOOL" "$TERM_COLS" "$TERM_LINES"
layout_install_resize_hook "$SESSION" "$SCRIPT_PATH"

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$SESSION"
else
  tmux attach-session -t "$SESSION"
fi
