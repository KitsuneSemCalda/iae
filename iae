#!/usr/bin/env bash
set -euo pipefail

for dep in tmux nvim omarchy-agent; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "iae: dependency '$dep' not found on PATH" >&2
    exit 1
  fi
done

GIT_TOOL=""
for candidate in tig lazygit; do
  if command -v "$candidate" >/dev/null 2>&1; then
    GIT_TOOL="$candidate"
    break
  fi
done
if [ -z "$GIT_TOOL" ]; then
  echo "iae: dependency 'tig' or 'lazygit' not found on PATH" >&2
  exit 1
fi

PROJECT_DIR="${1:-$PWD}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd -P)"
SESSION="iae-$(basename "$PROJECT_DIR" | tr '.: ' '_')-$(printf '%s' "$PROJECT_DIR" | cksum | cut -d' ' -f1)"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$SESSION"
  else
    tmux attach-session -t "$SESSION"
  fi
  exit 0
fi

# Mirrors omarchy-launch-editor's own TUI allowlist: only these are safe to
# exec inline in a tmux pane. A GUI default (code, cursor, emacs, ...) would
# detach and leave the pane idle, so fall back to nvim instead.
EDITOR_DEFAULT_FILE="$HOME/.local/state/omarchy/defaults/editor"
if [ -f "$EDITOR_DEFAULT_FILE" ]; then
  read -r EDITOR_CMD <"$EDITOR_DEFAULT_FILE"
else
  EDITOR_CMD="nvim"
fi
case "$EDITOR_CMD" in
  nvim | vim | nano | micro | hx | helix | fresh)
    command -v "$EDITOR_CMD" >/dev/null 2>&1 || EDITOR_CMD="nvim"
    ;;
  *)
    EDITOR_CMD="nvim"
    ;;
esac

# A detached session starts at tmux's default 80x24 until a client attaches,
# so splitting immediately would compute all percentages against that size.
# The later attach then rescales the whole layout to the real terminal size,
# which distorts nested split ratios (e.g. the git-log pane ending up smaller
# than the shell pane). Sizing the session to the real terminal up front
# avoids that rescale.
read -r TERM_LINES TERM_COLS < <(stty size 2>/dev/null) || true
TERM_COLS="${TERM_COLS:-80}"
TERM_LINES="${TERM_LINES:-24}"

EDITOR_PANE=$(tmux new-session -d -s "$SESSION" -x "$TERM_COLS" -y "$TERM_LINES" -c "$PROJECT_DIR" -n main -P -F '#{pane_id}')

AGENT_PANE=$(tmux split-window -t "$EDITOR_PANE" -h -l 35% -c "$PROJECT_DIR" -P -F '#{pane_id}')
tmux select-pane -t "$EDITOR_PANE"
SHELL_PANE=$(tmux split-window -t "$EDITOR_PANE" -v -l 35% -c "$PROJECT_DIR" -P -F '#{pane_id}')
GITLOG_PANE=$(tmux split-window -t "$SHELL_PANE" -h -l 70% -c "$PROJECT_DIR" -P -F '#{pane_id}')

tmux send-keys -t "$EDITOR_PANE" "$EDITOR_CMD ." C-m
tmux send-keys -t "$AGENT_PANE" "omarchy-agent --inline" C-m

if git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  tmux send-keys -t "$GITLOG_PANE" "$GIT_TOOL" C-m
else
  tmux send-keys -t "$GITLOG_PANE" "echo 'iae: not a git repository, $GIT_TOOL not started (run git init if you want one)'" C-m
fi

tmux select-pane -t "$EDITOR_PANE"

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$SESSION"
else
  tmux attach-session -t "$SESSION"
fi
